<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.hotel_app.presentation.ui.fragments.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.hotel_app.presentation.ui.fragments.BookingFragment"
        android:label="Booking" />

    <fragment
        android:id="@+id/keyFragment"
        android:name="com.example.hotel_app.presentation.ui.fragments.KeyFragment"
        android:label="NFC Key" />

    <fragment
        android:id="@+id/hotelInfoFragment"
        android:name="com.example.hotel_app.presentation.ui.fragments.HotelInfoFragment"
        android:label="Hotel Info" />
    
    <!-- ROLE 7 -->
    <fragment
        android:id="@+id/reviewsFragment"
        android:name="com.hotel.app.ui.fragments.ReviewsFragment"
        android:label="Отзывы">
        <action
            android:id="@+id/action_reviewsFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/servicesFragment"
        android:name="com.hotel.app.ui.fragments.ServicesFragment"
        android:label="Услуги">
        <action
            android:id="@+id/action_servicesFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.hotel.app.ui.fragments.PaymentFragment"
        android:label="Оплата">
        <argument
            android:name="service"
            app:argType="com.hotel.app.models.HotelService" />
        <action
            android:id="@+id/action_paymentFragment_to_bookedServicesFragment"
            app:destination="@id/bookedServicesFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookedServicesFragment"
        android:name="com.hotel.app.ui.fragments.BookedServicesFragment"
        android:label="Забронированные услуги">
        <argument
            android:name="bookedService"
            app:nullable="true"
            app:argType="com.hotel.app.models.HotelService"
            android:defaultValue="@null" />
    </fragment>
    <!-- ROLE 7 -->

</navigation>
