<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <TextView
        android:id="@+id/tvServicesTitle"
        style="@style/TextAppearance.HotelApp.SectionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:text="@string/services_catalog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvServicesSubtitle"
        style="@style/TextAppearance.HotelApp.BodyMuted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/services_catalog_subtitle"
        app:layout_constraintEnd_toEndOf="@id/tvServicesTitle"
        app:layout_constraintStart_toStartOf="@id/tvServicesTitle"
        app:layout_constraintTop_toBottomOf="@id/tvServicesTitle" />

    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="@id/tvServicesTitle"
        app:layout_constraintStart_toStartOf="@id/tvServicesTitle"
        app:layout_constraintTop_toBottomOf="@id/tvServicesSubtitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.HotelApp.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPA &amp; Wellness" />

            <TextView
                style="@style/Widget.HotelApp.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Transfer" />

            <TextView
                style="@style/Widget.HotelApp.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Food &amp; Drinks" />

            <TextView
                style="@style/Widget.HotelApp.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Leisure" />

            <TextView
                style="@style/Widget.HotelApp.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Business" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvServicesPreviewLabel"
        style="@style/TextAppearance.HotelApp.BodyMuted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/services_preview_category_label"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/tvServicesTitle"
        app:layout_constraintStart_toStartOf="@id/tvServicesTitle"
        app:layout_constraintTop_toBottomOf="@id/hsvCategories" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServices"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tvServicesTitle"
        app:layout_constraintStart_toStartOf="@id/tvServicesTitle"
        app:layout_constraintTop_toBottomOf="@id/tvServicesPreviewLabel"
        tools:itemCount="2"
        tools:listitem="@layout/layout_item_service" />

</androidx.constraintlayout.widget.ConstraintLayout>
