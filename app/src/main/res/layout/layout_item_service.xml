<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HotelApp.ServiceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivService"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_service_image_placeholder"
            android:contentDescription="@string/services_image_content_description"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvServiceBadge"
            style="@style/Widget.HotelApp.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:text="@string/services_popular_label"
            app:layout_constraintStart_toEndOf="@id/ivService"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvServiceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="Aroma Relax Massage"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivService"
            app:layout_constraintTop_toBottomOf="@id/tvServiceBadge" />

        <TextView
            android:id="@+id/tvServiceSubtitle"
            style="@style/TextAppearance.HotelApp.BodyMuted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Full-body recovery session with essential oils and a quiet lounge area."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvServiceTitle"
            app:layout_constraintTop_toBottomOf="@id/tvServiceTitle" />

        <TextView
            android:id="@+id/tvServicePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="4900 RUB"
            android:textColor="@color/brand_primary"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvServiceTitle"
            app:layout_constraintTop_toBottomOf="@id/tvServiceSubtitle" />

        <TextView
            android:id="@+id/tvServiceDuration"
            style="@style/TextAppearance.HotelApp.BodyMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="60 min"
            app:layout_constraintBaseline_toBaselineOf="@id/tvServicePrice"
            app:layout_constraintStart_toEndOf="@id/tvServicePrice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnServiceSelect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/services_select_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvServiceSubtitle" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
